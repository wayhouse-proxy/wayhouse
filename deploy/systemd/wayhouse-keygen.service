[Unit]
Description=Create the wayhouse sealed-secret keyring on first start
Before=wayhouse-controller.service
# Written via tmp+mv so a crash never leaves a truncated key; an empty file counts as missing.
# Never replaces an existing keyring: a lost key makes every stored secret unreadable.
ConditionFileNotEmpty=!/var/lib/wayhouse/secret.keys

[Service]
Type=oneshot
RemainAfterExit=yes
User=wayhouse
StateDirectory=wayhouse
UMask=0077
ExecStart=/bin/sh -c 'head -c 32 /dev/urandom | base64 > /var/lib/wayhouse/secret.keys.tmp && mv /var/lib/wayhouse/secret.keys.tmp /var/lib/wayhouse/secret.keys'
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
