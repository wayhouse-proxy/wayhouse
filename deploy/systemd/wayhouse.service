[Unit]
Description=wayhouse proxy (solo box, config from the local controller)
Wants=wayhouse-controller.service wayhouse-aggregator.service
After=wayhouse-controller.service wayhouse-aggregator.service
PartOf=wayhouse-solo.target

[Service]
User=wayhouse
# The tokens arrive as files under $CREDENTIALS_DIRECTORY; the program reads them from there
# (`wayhouse-controller init --target systemd` writes the sources under /etc/wayhouse/credentials).
LoadCredential=controller-token:/etc/wayhouse/credentials/proxy-token
LoadCredential=aggregator-token:/etc/wayhouse/credentials/ingest-token
ExecStart=/usr/local/bin/wayhouse \
  --controller=https://127.0.0.1:9901 \
  --ca-file=/etc/wayhouse/tls/ca.pem \
  --aggregator=http://127.0.0.1:9902 \
  --aggregator-instance=solo \
  --secret-key-file=/var/lib/wayhouse/secret.keys
# The game ports are usually above 1024; keep this line only if a listener binds below it.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=wayhouse-solo.target
