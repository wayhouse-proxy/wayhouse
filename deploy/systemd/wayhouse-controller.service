[Unit]
Description=wayhouse controller (solo box)
Documentation=https://github.com/wayhouse-proxy/wayhouse/blob/main/docs/12-deployment.md
Wants=wayhouse-keygen.service
After=wayhouse-keygen.service network.target
PartOf=wayhouse-solo.target

[Service]
User=wayhouse
StateDirectory=wayhouse
# Loopback only (the default listener), so the plain-HTTP guard needs no override.
# The tokens arrive as files under $CREDENTIALS_DIRECTORY; the program reads them from there
# (sh deploy/solo/init.sh --credentials /etc/wayhouse/credentials writes the sources).
LoadCredential=auth-token:/etc/wayhouse/credentials/controller-token
LoadCredential=proxy-token:/etc/wayhouse/credentials/proxy-token
LoadCredential=agent-token:/etc/wayhouse/credentials/agent-token
ExecStart=/usr/local/bin/wayhouse-controller \
  --listen=127.0.0.1:9901 \
  --data-dir=/var/lib/wayhouse/controller \
  --plugins \
  --secret-key-file=/var/lib/wayhouse/secret.keys
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryDenyWriteExecute=no

[Install]
WantedBy=wayhouse-solo.target
