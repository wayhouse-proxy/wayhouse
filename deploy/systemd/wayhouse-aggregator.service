[Unit]
Description=wayhouse aggregator (solo box)
After=network.target
PartOf=wayhouse-solo.target

[Service]
User=wayhouse
# The tokens arrive as files under $CREDENTIALS_DIRECTORY; the program reads them from there
# (sh deploy/solo/init.sh --credentials /etc/wayhouse/credentials writes the sources).
LoadCredential=auth-token:/etc/wayhouse/credentials/aggregator-token
LoadCredential=ingest-token:/etc/wayhouse/credentials/ingest-token
ExecStart=/usr/local/bin/wayhouse-aggregator \
  --listen=127.0.0.1:9902 \
  --instance-url-allow=127.0.0.0/8
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=

[Install]
WantedBy=wayhouse-solo.target
