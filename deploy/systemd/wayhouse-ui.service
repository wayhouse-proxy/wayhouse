[Unit]
Description=wayhouse web UI (solo box)
Wants=wayhouse-controller.service wayhouse-aggregator.service
After=wayhouse-controller.service wayhouse-aggregator.service
PartOf=wayhouse-solo.target

[Service]
User=wayhouse
# The tokens arrive as files under $CREDENTIALS_DIRECTORY; the program reads them from there
# (`wayhouse-controller init --target systemd` writes the sources under /etc/wayhouse/credentials).
LoadCredential=ui-password:/etc/wayhouse/credentials/ui-password
LoadCredential=controller-token:/etc/wayhouse/credentials/controller-token
LoadCredential=aggregator-token:/etc/wayhouse/credentials/aggregator-token
ExecStart=/usr/local/bin/wayhouse-ui \
  --listen=127.0.0.1:9903 \
  --controller-url=https://127.0.0.1:9901 \
  --ca-file=/etc/wayhouse/tls/ca.pem \
  --aggregator-url=http://127.0.0.1:9902
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=

[Install]
WantedBy=wayhouse-solo.target
