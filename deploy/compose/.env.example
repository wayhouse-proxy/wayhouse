# Copy to .env (git-ignored) and change every value before exposing anything.
WAYHOUSE_CONTROLLER_TOKEN=change-me-controller
# What proxies and tunnel agents present to the controller: scoped tokens that cannot
# submit config, install plugins or write secrets. Every controller token must differ.
WAYHOUSE_PROXY_TOKEN=change-me-proxy-token
WAYHOUSE_AGENT_TOKEN=change-me-agent-token
# What the UI presents: it reaches only the routes the console calls (no sealed secrets, no tunnel keys).
WAYHOUSE_UI_TOKEN=change-me-ui-token-16+
WAYHOUSE_AGGREGATOR_TOKEN=change-me-aggregator
# What wayhouse presents when pushing to the aggregator; must differ from the one above.
WAYHOUSE_INGEST_TOKEN=change-me-ingest
WAYHOUSE_UI_PASSWORD=change-me-ui-password-16+

# Needed only with compose.tunnel.yml:
# WAYHOUSE_TUNNEL_ENDPOINT=203.0.113.10:51820
